  },
  "dependencies": {
    "@vue/eslint-config-typescript": "14.9.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-oxlint": "1.90.0",
    "eslint-plugin-vue": "10.12.0",
    "oxfmt": "0.70.0",
    "oxlint": "1.90.0"
  },
  "engines": {
    "node": ">=22.18"
  }
