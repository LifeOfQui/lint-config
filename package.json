{
  "name": "@lifeofqui/lint-config",
  "version": "1.0.0",
  "description": "Shared ESLint, Oxlint and Oxfmt setup for Vue/Nuxt projects",
  "license": "MIT",
  "author": "Quirin Koch",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LifeOfQui/lint-config.git"
  },
  "files": [
    "eslint.js",
    "oxfmt.js",
    "oxlintrc.json"
  ],
  "type": "module",
  "exports": {
